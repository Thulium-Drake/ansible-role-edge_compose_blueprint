#!ipxe
# {{ ansible_managed }}
menu {{ blueprint['name'] }}
item --gap Stable Releases
{# Get all stable refs, but put the most stable (at the end of the list) up top #}
{% for ref in blueprint['stable_refs'] | default([]) | reverse %}
item {{ ref | regex_replace('/', '') }} ${space} {{ ref }}
{% endfor %}
item --gap Latest Unstable Release
item {{ blueprint['ref'] }} ${space} {{ blueprint['ref'] }}
choose --default ${menu} menu || goto exit
goto ${menu} ||


{% for ref in blueprint['stable_refs'] | default([]) + [blueprint['ref']] %}
:{{ ref | regex_replace('/', '') }}
imgfree
kernel {{ edge_compose_blueprint_repository_baseurl }}/{{ blueprint['distro'] }}/vmlinuz root=live:{{ edge_compose_blueprint_repository_baseurl }}/{{ blueprint['distro'] }}/install.img inst.ks={{ edge_compose_blueprint_repository_baseurl }}/{{ blueprint['name'] }}/install-{{ ref }}.ks initrd=initrd.img {{ blueprint['kickstart_extra_kernel_args'] | default('') }}
initrd {{ edge_compose_blueprint_repository_baseurl }}/{{ blueprint['distro'] }}/initrd.img
boot

{% endfor %}

:exit
clear menu
exit
